@startchen erd-chen
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam shadowing false

title SƠ ĐỒ E–R THEO BÀI GIẢNG — QUẢN LÝ CHUỖI RẠP PHIM\nHỆ THỐNG QUẢN LÝ CHUỖI RẠP CHIẾU PHIM

' Quy ước theo bài giảng & giáo trình CSDL (TS. Nguyễn Quỳnh Chi):
' 1. Chỉ biểu diễn thuộc tính bản thân thực thể; KHÔNG đưa khóa ngoại lên sơ đồ E-R (PDF tr. 45, Slide 5 tr. 26).
' 2. Không đưa thuộc tính dẫn xuất hoặc thuộc tính đa trị chưa tách vào quan hệ (Slide 7 tr. 14, PDF tr. 23 & 158).
' 3. Nhãn 1, N, M thể hiện lực lượng liên kết (Slide 3 tr. 18, PDF tr. 32).
' 4. Dấu = (xuất hai nét song song trên draw.io/SVG) thể hiện tham gia đầy đủ; dấu - thể hiện tham gia một phần (Slide 3 tr. 17, PDF tr. 31).
' 5. Thực thể kết hợp (<<associative>>: hình chữ nhật bao quanh hình thoi) không gán định danh riêng nhận khóa ghép ngầm định khi ánh xạ sang lược đồ quan hệ (Slide 5 tr. 18 & 33, PDF tr. 66 & 71-72).
' associative: movie_genre, screening_seat_lock

entity "CHI NHÁNH RẠP\n(cinema_branch)" as cinema_branch {
  branch_id <<key>>
  branch_code
  branch_name
  address
  city
  phone
  active
}
entity "PHÒNG CHIẾU\n(screening_room)" as screening_room {
  room_id <<key>>
  room_name
  room_type
  active
}
entity "HẠNG GHẾ\n(seat_type)" as seat_type {
  seat_type_code <<key>>
  type_name
  surcharge
}
entity "GHẾ VẬT LÝ\n(seat)" as seat {
  seat_id <<key>>
  seat_row
  seat_number
}
entity "PHIM ĐIỆN ẢNH\n(movie)" as movie {
  movie_id <<key>>
  movie_code
  title
  duration_minutes
  release_date
  age_rating
  country
  description
}
entity "THỂ LOẠI PHIM\n(genre)" as genre {
  genre_id <<key>>
  genre_name
  description
}
entity "PHIM – THỂ LOẠI\n(movie_genre)" as movie_genre <<associative>> {
}
entity "SUẤT CHIẾU\n(screening)" as screening {
  screening_id <<key>>
  start_time
  end_time
  base_price
  status
}
entity "KHÁCH HÀNG\n(customer)" as customer {
  customer_id <<key>>
  full_name
  phone
  email
  birth_date
  created_at
}
entity "NHÂN VIÊN\n(employee)" as employee {
  employee_id <<key>>
  employee_code
  full_name
  phone
  role
  hired_date
}
entity "ĐƠN ĐẶT VÉ\n(booking)" as booking {
  booking_id <<key>>
  booking_code
  booked_at
  booking_status
}
entity "VÉ XEM PHIM\n(ticket)" as ticket {
  ticket_id <<key>>
  unit_price
  ticket_status
  cancelled_at
}
entity "PHÂN BỔ GHẾ HIỆU LỰC\n(screening_seat_lock)" as screening_seat_lock <<associative>> {
}
entity "THANH TOÁN\n(payment)" as payment {
  payment_id <<key>>
  amount
  payment_method
  payment_status
  paid_at
  transaction_ref
}

relationship "Sở hữu" as R_BRANCH_ROOM {
}
cinema_branch -1- R_BRANCH_ROOM
R_BRANCH_ROOM =N= screening_room

relationship "Quản lý nhân sự" as R_BRANCH_EMP {
}
cinema_branch -1- R_BRANCH_EMP
R_BRANCH_EMP =N= employee

relationship "Chứa ghế" as R_ROOM_SEAT {
}
screening_room -1- R_ROOM_SEAT
R_ROOM_SEAT =N= seat

relationship "Phân hạng" as R_TYPE_SEAT {
}
seat_type -1- R_TYPE_SEAT
R_TYPE_SEAT =N= seat

' Thực thể kết hợp M:N giữa Phim và Thể loại (Slide 5 tr. 18 & 33)
movie -M- movie_genre
movie_genre -N- genre

relationship "Xếp lịch chiếu" as R_MOVIE_SCR {
}
movie -1- R_MOVIE_SCR
R_MOVIE_SCR =N= screening

relationship "Tổ chức tại" as R_ROOM_SCR {
}
screening_room -1- R_ROOM_SCR
R_ROOM_SCR =N= screening

relationship "Đặt mua" as R_CUST_BOOK {
}
customer -1- R_CUST_BOOK
R_CUST_BOOK -N- booking

relationship "Lập đơn" as R_EMP_BOOK {
}
employee -1- R_EMP_BOOK
R_EMP_BOOK =N= booking

relationship "Có đơn đặt" as R_SCR_BOOK {
}
screening -1- R_SCR_BOOK
R_SCR_BOOK =N= booking

relationship "Bao gồm vé" as R_BOOK_TICKET {
}
' BR-08: đơn mua hoàn chỉnh có ít nhất một vé; cả hai phía tham gia đầy đủ.
booking =1= R_BOOK_TICKET
R_BOOK_TICKET =N= ticket

relationship "Gán chỗ lịch sử" as R_SEAT_TICKET {
}
seat -1- R_SEAT_TICKET
R_SEAT_TICKET =N= ticket

' Thực thể kết hợp M:N giữa Suất chiếu và Ghế cho phân bổ hiệu lực (Slide 5 tr. 18 & 33)
screening -M- screening_seat_lock
screening_seat_lock -N- seat

' Quan hệ 1:1 tùy chọn - bắt buộc (Slide 5 tr. 30): đặt FK MaVe ở phía tham gia bắt buộc screening_seat_lock
relationship "Giữ khóa ghế" as R_LOCK_TICKET {
}
ticket -1- R_LOCK_TICKET
R_LOCK_TICKET =1= screening_seat_lock

relationship "Phát sinh thanh toán" as R_BOOK_PAY {
}
booking -1- R_BOOK_PAY
R_BOOK_PAY =N= payment
@endchen
