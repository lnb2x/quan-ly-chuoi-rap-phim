@startchen erd-chen
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam shadowing false

title SƠ ĐỒ E–R THEO BÀI GIẢNG — QUẢN LÝ CHUỖI RẠP PHIM\nHỆ THỐNG QUẢN LÝ CHUỖI RẠP CHIẾU PHIM

' Bản số 1/N là lực lượng liên kết theo slide 3, trang 18.
' Dấu = là tham gia đầy đủ; bản draw.io/SVG xuất thành hai nét theo slide 3, trang 17.
' associative: movie_genre, screening_seat_lock
' Bản draw.io là bản vẽ chính; PlantUML đối chiếu ngữ nghĩa các liên kết.
' Các thành phần khóa ghép được gạch chân đồng thời, không duy nhất riêng lẻ.
entity "CHI NHÁNH RẠP\n(cinema_branch)" as cinema_branch {
  branch_id <<key>>
  branch_code
  branch_name
  address
  city
  phone
  active
}
entity "PHÒNG CHIẾU\n(screening_room)" as screening_room {
  room_id <<key>>
  room_name
  room_type
  active
}
entity "HẠNG GHẾ\n(seat_type)" as seat_type {
  seat_type_code <<key>>
  type_name
  surcharge
}
entity "GHẾ VẬT LÝ\n(seat)" as seat {
  seat_id <<key>>
  seat_row
  seat_number
}
entity "PHIM ĐIỆN ẢNH\n(movie)" as movie {
  movie_id <<key>>
  movie_code
  title
  duration_minutes
  release_date
  age_rating
  country
  description
}
entity "THỂ LOẠI PHIM\n(genre)" as genre {
  genre_id <<key>>
  genre_name
  description
}
entity "PHIM – THỂ LOẠI\n(movie_genre)" as movie_genre {
  movie_id <<key>>
  genre_id <<key>>
}
entity "SUẤT CHIẾU\n(screening)" as screening {
  screening_id <<key>>
  start_time
  end_time
  base_price
  status
}
entity "KHÁCH HÀNG\n(customer)" as customer {
  customer_id <<key>>
  full_name
  phone
  email
  birth_date
  created_at
}
entity "NHÂN VIÊN\n(employee)" as employee {
  employee_id <<key>>
  employee_code
  full_name
  phone
  role
  hired_date
}
entity "ĐƠN ĐẶT VÉ\n(booking)" as booking {
  booking_id <<key>>
  booking_code
  booked_at
  booking_status
}
entity "VÉ XEM PHIM\n(ticket)" as ticket {
  ticket_id <<key>>
  unit_price
  ticket_status
  cancelled_at
}
entity "PHÂN BỔ GHẾ HIỆU LỰC\n(screening_seat_lock)" as screening_seat_lock {
  screening_id <<key>>
  seat_id <<key>>
}
entity "THANH TOÁN\n(payment)" as payment {
  payment_id <<key>>
  amount
  payment_method
  payment_status
  paid_at
  transaction_ref
}

relationship "Sở hữu" as R_BRANCH_ROOM {
}
cinema_branch -1- R_BRANCH_ROOM
R_BRANCH_ROOM =N= screening_room

relationship "Quản lý nhân sự" as R_BRANCH_EMP {
}
cinema_branch -1- R_BRANCH_EMP
R_BRANCH_EMP =N= employee

relationship "Chứa ghế" as R_ROOM_SEAT {
}
screening_room -1- R_ROOM_SEAT
R_ROOM_SEAT =N= seat

relationship "Phân hạng" as R_TYPE_SEAT {
}
seat_type -1- R_TYPE_SEAT
R_TYPE_SEAT =N= seat

relationship "Có phân loại" as R_MOVIE_MG {
}
movie -1- R_MOVIE_MG
R_MOVIE_MG =N= movie_genre

relationship "Gán thể loại" as R_GENRE_MG {
}
genre -1- R_GENRE_MG
R_GENRE_MG =N= movie_genre

relationship "Xếp lịch chiếu" as R_MOVIE_SCR {
}
movie -1- R_MOVIE_SCR
R_MOVIE_SCR =N= screening

relationship "Tổ chức tại" as R_ROOM_SCR {
}
screening_room -1- R_ROOM_SCR
R_ROOM_SCR =N= screening

relationship "Đặt mua" as R_CUST_BOOK {
}
customer -1- R_CUST_BOOK
R_CUST_BOOK -N- booking

relationship "Lập đơn" as R_EMP_BOOK {
}
employee -1- R_EMP_BOOK
R_EMP_BOOK =N= booking

relationship "Đặt cho suất" as R_SCR_BOOK {
}
screening -1- R_SCR_BOOK
R_SCR_BOOK =N= booking

relationship "Bao gồm vé" as R_BOOK_TICKET {
}
' BR-08: đơn mua hoàn chỉnh có ít nhất một vé; điều kiện được BookingService bảo vệ.
booking =1= R_BOOK_TICKET
R_BOOK_TICKET =N= ticket

relationship "Gán chỗ lịch sử" as R_SEAT_TICKET {
}
seat -1- R_SEAT_TICKET
R_SEAT_TICKET =N= ticket

relationship "Khóa theo suất" as R_LOCK_SCR {
}
screening -1- R_LOCK_SCR
R_LOCK_SCR =N= screening_seat_lock

relationship "Giữ chỗ ghế" as R_LOCK_SEAT {
}
seat -1- R_LOCK_SEAT
R_LOCK_SEAT =N= screening_seat_lock

relationship "Giữ khóa khi VALID" as R_LOCK_TICKET {
}
R_LOCK_TICKET -1- ticket
R_LOCK_TICKET =1= screening_seat_lock

relationship "Thanh toán đơn" as R_BOOK_PAY {
}
booking -1- R_BOOK_PAY
R_BOOK_PAY =N= payment
@endchen
