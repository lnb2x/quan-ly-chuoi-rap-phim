        <mxCell id="legend" value="&lt;b&gt;QUY ƯỚC THEO BÀI GIẢNG&lt;/b&gt;&lt;br&gt;Chữ nhật: thực thể; hình thoi: liên kết; elip: thuộc tính; gạch chân: khóa chính.&lt;br&gt;Chữ nhật kèm hình thoi: thực thể kết hợp. Hai cột khóa gạch chân tạo MỘT khóa ghép.&lt;br&gt;1 / N: lực lượng liên kết; đường kép: tham gia đầy đủ; đường đơn: tham gia một phần.&lt;br&gt;BR-08: mỗi đơn mua có ít nhất một vé; vé thuộc đúng một đơn. Khách vãng lai không bắt buộc có hồ sơ thành viên.&lt;br&gt;Phân bổ ghế: chỉ vé VALID có đúng 1 phân bổ; vé CANCELLED không có. Suất và ghế phải khớp với vé (BR-09/10).&lt;br&gt;Chưa yêu cầu tối thiểu 1 phòng/nhân viên/ghế cho chi nhánh/phòng mới tạo: giữ tham gia một phần và ghi rõ giả định nghiệp vụ.&lt;br&gt;Phim–Thể loại được thể hiện bằng thực thể kết hợp; ánh xạ sang bảng movie_genre theo slide 5, trang 32–33." style="rounded=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#FFF9E6;strokeColor=#B29B56;fontFamily=Arial;fontColor=#17324D;fontSize=16;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2100" y="2790.513" width="1900" height="250" />
        </mxCell>
        <mxCell id="movie_genre_association" value="PHIM – THỂ LOẠI&lt;br&gt;(movie_genre)" vertex="1" parent="movie_genre" connectable="0" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#639C80;fontColor=#17324D;fontFamily=Arial;fontSize=16;fontStyle=1;">
