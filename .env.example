# Cấu hình kết nối Cơ sở dữ liệu MySQL 8.4 LTS - Hệ thống Quản lý Chuỗi Rạp Chiếu Phim
# Sao chép tệp này thành .env hoặc cấu hình trong tệp cục bộ config/application.properties (không đưa mật khẩu thật lên Git)

CINEMA_DB_URL=jdbc:mysql://127.0.0.1:3306/cinema_chain?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&useSSL=false
CINEMA_DB_USER=cinema_app
CINEMA_DB_PASSWORD=<YOUR_LOCAL_DB_PASSWORD>

# Cấu hình cơ sở dữ liệu kiểm thử tích hợp (Integration Test trên MySQL 8.4 LTS)
CINEMA_TEST_DB_URL=jdbc:mysql://127.0.0.1:3306/cinema_chain_test?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&useSSL=false
CINEMA_TEST_DB_USER=cinema_app
CINEMA_TEST_DB_PASSWORD=<YOUR_LOCAL_DB_PASSWORD>
